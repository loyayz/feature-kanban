{
  "name": "feature-kanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "tsc -p tsconfig.server.json && ng build && node dist/server/server/index.js",
    "dev:server": "tsc -p tsconfig.server.json && node dist/server/server/index.js",
    "dev:web": "ng serve --proxy-config web/proxy.conf.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "ng build",
    "build": "tsc -p tsconfig.server.json && ng build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && ng build --configuration development",
    "test:server": "tsc -p tsconfig.test.json && node --test dist/test/test/server/*.test.js",
    "test:inject": "tsc -p tsconfig.test.json && node --test dist/test/test/inject/*.test.js",
    "test:launcher": "tsc -p tsconfig.test.json && node --test dist/test/test/launcher/*.test.js",
    "test:skill": "tsc -p tsconfig.test.json && node --test dist/test/test/skill/*.test.js",
    "test:installer": "tsc -p tsconfig.test.json && node --test dist/test/test/installer/*.test.js",
    "test:web": "ng test --watch=false",
    "test": "npm run test:server && npm run test:web && npm run test:inject && npm run test:launcher && npm run test:skill && npm run test:installer",
    "stage:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-windows-package.ps1",
    "verify:package": "tsc -p tsconfig.test.json && node dist/test/scripts/verify-windows-package.js",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "stage:macos": "tsc -p tsconfig.test.json && node dist/test/scripts/stage-macos-package.js",
    "verify:macos": "tsc -p tsconfig.test.json && node dist/test/scripts/verify-macos-package.js",
    "build:installer:macos": "bash scripts/build-macos-installer.sh",
    "check": "npm run typecheck && npm run test",
    "check:macos": "npm run typecheck && npm run test && npm run build && npm run build:installer:macos"
  },
  "dependencies": {
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@types/node": "24.10.1",
    "jsdom": "26.1.0",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.1.0"
  },
  "packageManager": "npm@11.12.1"
}
